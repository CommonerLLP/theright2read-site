   "@id": "udise:facility_data.pseudocode",
   "@type": "skos:Concept",
   "inScheme": "udise:scheme",
   "broader": "udise:section-2",
   "identifier": "facility_data.pseudocode",
   "prefLabel": "pseudocode",
   "isPartOf": "facility_data",
