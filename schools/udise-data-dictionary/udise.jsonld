 "@graph": [
  {
   "@id": "udise:scheme",
   "@type": "skos:ConceptScheme",
   "dct:title": "UDISE+ field dictionary: what was collected, how it was worded, whether it was shared",
   "dct:publisher": {
    "@id": "https://www.education.gov.in"
   },
   "dct:source": {
    "@id": "https://udiseplus.gov.in"
   },
   "temporal": "2018-19/2025-26",
   "dct:rights": "Vocabulary CC BY-NC 4.0, The Right to Read."
  },
  {
   "@id": "udise:section-1",
   "@type": "skos:Concept",
   "inScheme": "udise:scheme",
   "prefLabel": "School Profile",
   "definition": "Identity, location, management and recognition. Also the grants a school receives."
  },
  {
   "@id": "udise:section-2",
   "@type": "skos:Concept",
   "inScheme": "udise:scheme",
   "prefLabel": "Physical Facilities",
   "definition": "Buildings, rooms, toilets, water, electricity, library, playground and computers. A yes/no here is often a type code with eight values."
  },
  {
   "@id": "udise:section-3",
   "@type": "skos:Concept",
   "inScheme": "udise:scheme",
   "prefLabel": "Teaching and Non-Teaching Staff",
   "definition": "Headcount by qualification, caste, employment type and class taught. UDISE collects no sanctioned posts. It collects no vacancies."
  },
  {
   "@id": "udise:section-4",
   "@type": "skos:Concept",
   "inScheme": "udise:scheme",
   "prefLabel": "Students",
   "definition": "Enrolment by class, sex, social category and minority group. From 2022-23 UDISE collects each student individually. That change is the break the whole series turns on."
  },
  {
   "@id": "udise:series.profile_data_2.rte_bld_c0_b",
