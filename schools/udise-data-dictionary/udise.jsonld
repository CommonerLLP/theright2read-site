   "hasVersion": [
    "udise:teacher_data.total_tch",
    "udise:teacher_data.total_teacher"
   ],
   "historyNote": [
    "total_teacher -> total_tch: DCF item 3.2 'Number of Teaching Staff In-position' carries a grid whose right-hand column is headed 'Total Number of Teaching Staff'. The item and the heading are identical in the 2021-22 and 2022-23 forms. The Ministry's schema describes the pair as 'Total Number of Teacher' and then 'No. of teachers in school'. An earlier version of this entry said no form item stated the count. That was wrong, and Codex caught it: the search had used the phrasings 'total number of teachers' and 'teachers in position', and the form says 'Teaching Staff In-position'"
   ],
   "definition": "Number of Teaching Staff In-position"
  },
