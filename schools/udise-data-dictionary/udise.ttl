    dct:valid "2022-23, 2023-24, 2024-25, 2025-26" ;
    skos:definition "Number of Teaching Staff In-position"@en ;
    skos:editorialNote "Question: a person opened the form and read the item, from the 2025-26 Data Capture Format."@en ;
    dct:references "DCF item 3.2" ;
    skos:scopeNote "count"@en ;
    dct:provenance "Shared 2022-23 to 2025-26 as smallint, described as “No. of teachers in school”"@en ;
    dct:isVersionOf udise:series.teacher_data.total_teacher ;
    skos:altLabel "total_teacher"@en ;
    skos:historyNote "{\"at\": \"2021-22 to 2022-23\", \"action\": \"RENAME\", \"from\": \"total_teacher\", \"to\": \"total_tch\", \"basis\": \"DCF item 3.2 'Number of Teaching Staff In-position' carries a grid whose right-hand column is headed 'Total Number of Teaching Staff'. The item and the heading are identical in the 2021-22 and 2022-23 forms. The Ministry's schema describes the pair as 'Total Number of Teacher' and then 'No. of teachers in school'. An earlier version of this entry said no form item stated the count. That was wrong, and Codex caught it: the search had used the phrasings 'total number of teachers' and 'teachers in position', and the form says 'Teaching Staff In-position'\", \"similarity\": null, \"confidence\": \"confirmed\", \"how\": \"grid\"}"@en .

