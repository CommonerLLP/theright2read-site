    dct:isVersionOf udise:series.facility_data.urinla_girls ;
    skos:altLabel "urinla_girls"@en ;
    skos:historyNote "{\"at\": \"2021-22 to 2022-23\", \"action\": \"RENAME\", \"from\": \"urinla_girls\", \"to\": \"urinal_girls\", \"basis\": \"the Girls cell of DCF item 2.5(a)(iii) 'Total number of urinals available'. The grid is identical in the 2021-22 and 2022-23 forms, headings and rows alike. The Boys cell settles the pair on its own: urinal_boys is spelled correctly in all eight releases and never changes, while only the Girls cell carries 'urinla' from 2018-19 to 2021-22. The 2022-23 release corrects it\", \"similarity\": null, \"confidence\": \"confirmed\", \"how\": \"grid\"}"@en ;
    skos:note "urinal-typo: `urinla_girls` is a transposition. It is corrected to `urinal_girls` at 2022-23."@en .

