@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.education.gov.in> a foaf:Organization ;
    rdfs:label "Ministry of Education, Government of India"@en .

udise:scheme a skos:ConceptScheme ;
    dct:title "UDISE+ field dictionary: what was collected, how it was worded, whether it was shared"@en ;
    dct:publisher <https://www.education.gov.in> ;
    dct:source <https://udiseplus.gov.in> ;
    dct:temporal "2018-19/2025-26" ;
    dct:description "Every column released in a UDISE+ school-level microdata file, 2018-19 to 2025-26, with the Data Capture Format wording that produced it where that wording has been checked by hand."@en ;
    dct:rights "Vocabulary CC BY-NC 4.0, The Right to Read. The underlying data is the Ministry's."@en ;
    prov:wasGeneratedBy "The Right to Read, from the Ministry of Education published documents" .

udise:section-1 a skos:Concept ;
    skos:inScheme udise:scheme ;
    skos:topConceptOf udise:scheme ;
    skos:prefLabel "School Profile"@en ;
    skos:definition "Identity, location, management and recognition. Also the grants a school receives."@en .

udise:section-2 a skos:Concept ;
    skos:inScheme udise:scheme ;
    skos:topConceptOf udise:scheme ;
    skos:prefLabel "Physical Facilities"@en ;
    skos:definition "Buildings, rooms, toilets, water, electricity, library, playground and computers. A yes/no here is often a type code with eight values."@en .

udise:section-3 a skos:Concept ;
    skos:inScheme udise:scheme ;
    skos:topConceptOf udise:scheme ;
    skos:prefLabel "Teaching and Non-Teaching Staff"@en ;
    skos:definition "Headcount by qualification, caste, employment type and class taught. UDISE collects no sanctioned posts. It collects no vacancies."@en .

udise:section-4 a skos:Concept ;
    skos:inScheme udise:scheme ;
    skos:topConceptOf udise:scheme ;
    skos:prefLabel "Students"@en ;
    skos:definition "Enrolment by class, sex, social category and minority group. From 2022-23 UDISE collects each student individually. That change is the break the whole series turns on."@en .

